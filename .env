# ClaudeClaw — Plugin-weite Secrets
# Kopiere diese Datei zu .env und trage deine Keys ein. .env ist gitignored.

# OpenAI API-Key — wird genutzt für:
#   - TTS (Sprachausgabe) in speak.sh
#   - Whisper STT (eingehende Voice-Notes transkribieren)
#   - Voice-Note-Generierung für Bridge-Antworten
# NOTE: Set via CORVIN_TTS_OPENAI_KEY in ~/.config/corvin-voice/service.env
# to avoid confusing the claude CLI which treats OPENAI_API_KEY as primary auth
# OPENAI_API_KEY=sk-...

# Anthropic API-Key — OPTIONAL.
# Wenn nicht gesetzt, nutzt summarize.py automatisch die `claude` CLI
# (= dein Claude-Code-OAuth-Token, kein separater Key nötig).
# ANTHROPIC_API_KEY=sk-ant-...

GITHUB_TOKEN=ghp_PLACEHOLDER_CorvinOS_20260916_201207

# NOTE: Multiple stale GitHub tokens were removed during Blocker 3 rotation.
# Replace with a fresh token from https://github.com/settings/tokens

HETZNER_API_TOKEN=PLACEHOLDER_HETZNER_API_20260916_201207
HETZNER_ROOT_PASSWORT=PLACEHOLDER_SSH_ROOT_20260916_201207

# Hetzner credentials: Log in to https://console.hetzner.cloud/account/security/api-tokens

CLOUDFLARE_ID=PLACEHOLDER_CF_ID_20260916_201207
CLOUDFLARE_API_TOKEN=PLACEHOLDER_CF_API_20260916_201207

# Cloudflare credentials: Regenerate at https://dash.cloudflare.com/profile/api-tokens

PYPI_TOKEN=PLACEHOLDER_PYPI_20260916_201207
# OPENAI_API_KEY removed 2026-07-28: was a 19-char placeholder (…-enc).
# Real OpenAI access uses the dedicated CORVIN_STT/TTS_OPENAI_KEY in
# service.env; a generic OPENAI_API_KEY confuses the claude CLI (see above).
# OPENAI_API_KEY=

RESEND_API_KEY=PLACEHOLDER_RESEND_20260916_201207

# Resend API key rotated. Get new key at https://resend.com/settings/api-keys
RESEND_FROM="CorvinOS Licensing <licenses@corvin-labs.com>"

# ADR-0269: Context Engineering Layer (Phase 1 Lite)
# Enable Memory Lookup for task enrichment (Week 2 deployment)
CONTEXT_ENGINEERING_ENABLED=true

# ===== Corvin-Keys Credential Rotation (GDPR-critical, 2026-09-18) =====
MEMBER_CREDENTIAL_PATH=Corvin-Keys/member_license.jwt
SIGNING_KEY_PATH=Corvin-Keys/signer.pem
SIGNING_KEY_PUBLIC_PATH=Corvin-Keys/signer.pub
