# Multi-stage Dockerfile for CorvinOS Console (Production)
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /build

# Copy only requirements first (cache dependencies)
COPY core/console/requirements.txt .
COPY core/gateway/requirements.txt requirements-gateway.txt
COPY core/vibe_engineering/requirements-test.txt requirements-vibe.txt

# Combine and deduplicate requirements
RUN cat *.txt | sort | uniq > combined-requirements.txt && \
    pip install --user --no-warn-script-location -r combined-requirements.txt

# Runtime stage
FROM python:3.12-slim

# PYTHONPATH: /app for the ``core.*`` packages, /app/core/console for the
# ``corvin_console`` package the standalone host lives in.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/core/console \
    CORVIN_HOME=/var/lib/corvin

WORKDIR /app

# Non-root user
RUN groupadd --system --gid 4711 corvin && \
    useradd --system --uid 4711 --gid 4711 --home /var/lib/corvin corvin && \
    mkdir -p /var/lib/corvin/tenants/_default/global && \
    chown -R corvin:corvin /var/lib/corvin

# Copy installed Python packages from builder
COPY --from=builder /root/.local /home/corvin/.local

# Copy entire source tree (all core modules)
COPY --chown=corvin:corvin core/ /app/core/
COPY --chown=corvin:corvin operator/ /app/operator/

# Ensure venv/pip are in PATH
ENV PATH=/home/corvin/.local/bin:$PATH

EXPOSE 8765

USER corvin

# Health check — /v1/console/healthz is the unauthenticated liveness probe
# (deps.PUBLIC_ROUTES); the previous /v1/console/api/tasks/health never existed (404).
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/v1/console/healthz')" || exit 1

# Start console through the SHIPPED host: corvin_console.standalone.create_app()
# runs bootstrap.boot_platform() (ADR-0232/0233 boot tripwire), the dual-gate
# middleware and the SPA mount. ``corvin_console.app:app`` is the bare router
# app with none of that and must never be the production entrypoint.
ENTRYPOINT ["uvicorn", "corvin_console.standalone:create_app", "--factory", \
            "--host", "0.0.0.0", "--port", "8765", "--log-level", "info"]
