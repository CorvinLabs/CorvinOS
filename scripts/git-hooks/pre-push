#!/usr/bin/env python3
"""Git pre-push hook: the forbidden-term scan. The logic lives in ``term_scan.py`` beside this file (git requires the
hook to be named exactly ``pre-push``)."""
import os
import runpy
import sys

sys.argv[0] = os.path.join(os.path.dirname(os.path.abspath(__file__)), "term_scan.py")
runpy.run_path(sys.argv[0], run_name="__main__")
