[Unit]
Description=Daily Audit Chain Verification (Phase B, ADR-0541)
Documentation=https://github.com/CorvinLabs/Corvin-ADR/decisions/ADR-0541-session-bridging-eventstore-protocol.md
After=network.target

[Timer]
# Run every day at 02:00 UTC
OnCalendar=*-*-* 02:00:00
Persistent=true
Unit=corvin-audit-verify.service

[Install]
WantedBy=timers.target
