{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorvinOS Plugin Manifest Schema",
  "description": "Standard plugin.json for all Buildin and Contributor plugins (ADR-0455)",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version",
    "author",
    "license",
    "tier",
    "category",
    "description",
    "distribution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^plugin:(buildin|contributor)-[a-z_]+(-[a-z_]+)?$",
      "description": "Unique plugin ID (format: plugin:tier-category-plugin_slug)",
      "examples": [
        "plugin:buildin-memory-cel_session_memory",
        "plugin:contributor-security-custom_auth"
      ]
    },
    "type": {
      "type": "string",
      "enum": ["plugin"],
      "description": "Always 'plugin' (reserved for future extension types)"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "Human-readable plugin name",
      "examples": ["CEL Session Memory", "Custom Auth Provider"]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version (e.g., 1.0.0, 1.2.3-alpha, 2.0.0+build.1)"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Plugin author/maintainer name",
      "examples": ["Anthropic PBC", "Jane Doe"]
    },
    "license": {
      "type": "string",
      "enum": ["Apache-2.0", "MIT"],
      "description": "SPDX license identifier. Buildin: Apache-2.0. Contributor: MIT or Apache-2.0."
    },
    "license_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to full license text",
      "examples": [
        "https://github.com/anthropics/CorvinOS/blob/main/LICENSE",
        "https://opensource.org/licenses/MIT"
      ]
    },
    "tier": {
      "type": "string",
      "enum": ["buildin", "contributor"],
      "description": "Plugin tier determines SLA, support, audit requirements"
    },
    "category": {
      "type": "string",
      "enum": [
        "memory",
        "security_compliance",
        "integration",
        "data_processing",
        "observability"
      ],
      "description": "Plugin category for discovery and browsing"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Brief description of plugin purpose and features"
    },
    "readme_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to README.md (must be publicly accessible)"
    },
    "distribution": {
      "type": "object",
      "required": ["supports_source", "supports_wheel"],
      "properties": {
        "supports_source": {
          "type": "boolean",
          "description": "Whether plugin is available as source (always true for buildin)"
        },
        "supports_wheel": {
          "type": "boolean",
          "description": "Whether plugin is available as .whl (pre-built binary)"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to source code (GitHub, GitLab, etc.)"
        },
        "wheel_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to downloadable .whl file (if supports_wheel=true)"
        },
        "wheel_signature_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to GPG signature for wheel (RFC 3161 format)"
        },
        "wheel_checksum": {
          "type": "string",
          "pattern": "^(sha256|sha512):[a-f0-9]+$",
          "description": "Checksum for wheel integrity (format: sha256:hex or sha512:hex)"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^plugin:(buildin|contributor)-[a-z_]+(-[a-z_]+)?$"
      },
      "description": "List of plugin IDs this plugin depends on (plugin-to-plugin dependencies)"
    },
    "requires_version": {
      "type": "string",
      "pattern": "^(>=|>|<=|<|~|\\^)?\\d+\\.\\d+\\.\\d+.*$",
      "description": "CorvinOS version requirement (semver range, e.g., >=1.0.0, ^1.2.3)",
      "default": ">=1.0.0"
    },
    "boot_layer": {
      "type": "string",
      "enum": ["compliance", "core", "bundled", "installed"],
      "description": "Boot layer (ADR-0243): controls load order and disableability"
    },
    "sla_level": {
      "type": "string",
      "enum": ["buildin", "contributor"],
      "description": "SLA tier. Buildin: 48h bugfix, 24h security patch. Contributor: no SLA."
    },
    "security_audit": {
      "type": "object",
      "properties": {
        "last_audit_date": {
          "type": "string",
          "format": "date",
          "description": "ISO date of last security audit (YYYY-MM-DD)"
        },
        "auditor": {
          "type": "string",
          "description": "Who performed the audit (person/team name)"
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of outstanding security findings"
        },
        "findings_by_severity": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        },
        "audit_report_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to full audit report (if public)"
        }
      },
      "description": "Security audit metadata (buildin plugins: required; contributor plugins: optional)"
    },
    "maintainer_url": {
      "type": "string",
      "format": "uri",
      "description": "Contact URL for maintainer (mailto:email or https://support-page)",
      "examples": [
        "mailto:plugins@anthropic.com",
        "https://anthropic.com/support"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ai-learning",
          "memory",
          "security",
          "compliance",
          "observability",
          "integration",
          "data",
          "performance",
          "experimental"
        ]
      },
      "maxItems": 5,
      "description": "Search tags (in addition to category)"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last plugin update"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "tier": { "const": "buildin" } } },
      "then": {
        "required": ["license_url", "security_audit", "boot_layer"],
        "properties": {
          "license": { "const": "Apache-2.0" },
          "sla_level": { "const": "buildin" },
          "distribution": {
            "properties": {
              "supports_source": { "const": true },
              "supports_wheel": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "tier": { "const": "contributor" } } },
      "then": {
        "properties": {
          "sla_level": { "const": "contributor" }
        }
      }
    }
  ]
}
