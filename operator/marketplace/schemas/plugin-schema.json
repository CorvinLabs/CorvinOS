{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorvinOS Plugin Manifest Schema",
  "description": "Standard schema for all CorvinOS plugins (buildin and contributor)",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version",
    "author",
    "license",
    "tier",
    "category",
    "description",
    "distribution",
    "boot_layer"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique plugin identifier in format: plugin:{tier}-{category}-{plugin_id}",
      "pattern": "^plugin:(buildin|contributor)-[a-z][a-z0-9_]*-[a-z0-9_]+$"
    },
    "type": {
      "type": "string",
      "enum": ["plugin"],
      "description": "Artifact type (always 'plugin')"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable plugin name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
      "description": "Semantic version (e.g., 1.0.0, 1.0.0-rc1)"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Author/maintainer name"
    },
    "license": {
      "type": "string",
      "enum": ["Apache-2.0", "MIT"],
      "description": "License type (buildin=Apache-2.0, contributor=MIT)"
    },
    "tier": {
      "type": "string",
      "enum": ["buildin", "contributor"],
      "description": "Plugin tier (buildin=SLA+audit, contributor=community)"
    },
    "category": {
      "type": "string",
      "enum": ["memory", "security_compliance", "integration", "data_processing", "observability"],
      "description": "Plugin category for marketplace organization"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Short description of plugin functionality"
    },
    "keywords": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 10,
      "description": "Optional search keywords"
    },
    "repository": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["git"]},
        "url": {"type": "string", "format": "uri"}
      },
      "description": "Source repository (optional)"
    },
    "documentation": {
      "type": "string",
      "format": "uri",
      "description": "Link to plugin documentation"
    },
    "distribution": {
      "type": "object",
      "required": ["supports_source", "supports_wheel"],
      "additionalProperties": false,
      "properties": {
        "supports_source": {
          "type": "boolean",
          "description": "Plugin available as source (git clone / copy code)"
        },
        "supports_wheel": {
          "type": "boolean",
          "description": "Plugin available as wheel (.whl binary)"
        },
        "wheel_url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "URL to pre-built wheel (required if supports_wheel=true)"
        },
        "wheel_checksum": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA256 checksum of wheel (required if supports_wheel=true)"
        },
        "source_url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "URL to source repository"
        }
      },
      "description": "Distribution channels and artifacts"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[>=<~^]?\\d+\\.\\d+\\.\\d+.*$"
      },
      "description": "Plugin dependencies (plugin_id: version_constraint)"
    },
    "boot_layer": {
      "type": "string",
      "enum": ["compliance", "core", "bundled", "installed"],
      "description": "Boot layer (per ADR-0243)"
    },
    "sla_level": {
      "type": ["string", "null"],
      "enum": ["buildin", "community", null],
      "description": "SLA level (buildin only)"
    },
    "security_audit": {
      "type": ["object", "null"],
      "required": ["last_audit_date", "findings"],
      "additionalProperties": false,
      "properties": {
        "last_audit_date": {
          "type": "string",
          "format": "date",
          "description": "Date of last security audit (YYYY-MM-DD)"
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of open security findings"
        },
        "audit_url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "Link to audit report"
        }
      },
      "description": "Security audit information (buildin plugins only)"
    },
    "entry_point": {
      "type": "string",
      "description": "Python entry point (e.g., 'plugin.module:PluginClass')"
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of capabilities this plugin provides"
    },
    "rating": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 5,
      "description": "Average user rating (1–5 stars)"
    },
    "installs": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Number of installations"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp (ISO 8601)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (ISO 8601)"
    }
  }
}
