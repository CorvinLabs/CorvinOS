# ── Trading backtest artifacts (binary parquet, too large for git) ───────────
backtests/

# ── Secrets / personal data ─────────────────────────────────────────────────
.env
.env.local
*.local.env
.env.tmp
venv
*.bak

# Local Claude Code session state (per-checkout, never committed)
.claude/

# LDD write-probe artifact (transient, written at session start)
.ldd_probe_tmp.txt

# LDD per-project tooling state (config, trace, statusline — never committed)
.ldd/

# CorvinOS user-state root (per-checkout, never committed)
.CorvinOS/

# Corvin-OS user-state root + auto-update marker (per-checkout, never committed)
.corvin/

# Channel-specific credentials and tokens (ADR-0035: corvin_operator/bridges/)
corvin_operator/bridges/discord/settings.json
corvin_operator/bridges/telegram/settings.json
corvin_operator/bridges/slack/settings.json
corvin_operator/bridges/email/settings.json
corvin_operator/bridges/whatsapp/settings.json
corvin_operator/bridges/whatsapp/auth/
# Timestamped credential backups (created by bridge.sh) — same secrets as auth/,
# must never be committed.
corvin_operator/bridges/whatsapp/auth.bak.*/

# Session state and message archives (private conversations)
corvin_operator/bridges/shared/inbox/
corvin_operator/bridges/shared/outbox/
corvin_operator/bridges/shared/processed/
# Per-bridge runtime dirs (filled by the daemons, drained by the adapter).
corvin_operator/bridges/discord/inbox/
corvin_operator/bridges/discord/outbox/
corvin_operator/bridges/discord/processed/
corvin_operator/bridges/telegram/inbox/
corvin_operator/bridges/telegram/outbox/
corvin_operator/bridges/telegram/processed/
corvin_operator/bridges/slack/inbox/
corvin_operator/bridges/slack/outbox/
corvin_operator/bridges/slack/processed/
corvin_operator/bridges/email/inbox/
corvin_operator/bridges/email/outbox/
corvin_operator/bridges/email/processed/
corvin_operator/bridges/console/inbox/
corvin_operator/bridges/console/outbox/
corvin_operator/bridges/console/processed/

# Bridge attachments — user-uploaded content (private by default,
# may contain chat exports, PDFs, screenshots). NEVER commit.
corvin_operator/bridges/email/attachments/
corvin_operator/bridges/discord/attachments/
corvin_operator/bridges/telegram/attachments/
corvin_operator/bridges/slack/attachments/
corvin_operator/bridges/whatsapp/attachments/
corvin_operator/bridges/shared/attachments/

# A2A pairing records + pending invites — contain HMAC/recv key material
# (256-bit secrets). Must never be committed; pairing is per-instance via
# `corvin-a2a pair` / the console. See ADR-0048 (L38).
corvin_operator/cowork/remote_origins/
corvin_operator/cowork/remote_endpoints/
corvin_operator/cowork/pending_invites/
corvin_operator/cowork/remote_pending_friendships/

# Voice / cowork per-session state (transcripts, recordings, session JSON)
corvin_operator/voice/sessions/
corvin_operator/cowork/sessions/

# Audit logs and runtime state outside .corvin/
core/**/audit.jsonl
core/**/*.session.json
corvin_operator/**/audit.jsonl
corvin_operator/**/*.session.json

# ── Build artifacts ────────────────────────────────────────────────────────
node_modules/
# package-lock.json is committed for the web console SPA (reproducible CI builds;
# npm ci requires the lock file). Only suppress it in operator bridges where npm
# install runs at container/deploy time and the lock file is environment-specific.
corvin_operator/**/package-lock.json
*.pyc
__pycache__/
.pytest_cache/
.coverage
sbom.cdx.json

# ── Generated reports ──────────────────────────────────────────────────────
compliance_audit_report.json
e2e_validation_report.json
# Python virtualenvs (regenerated by each component's bootstrap.sh — never commit)
.venv/
**/.venv/
*.egg-info/
*.egg-info/

# ── Editor / OS noise ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs and temporary files ───────────────────────────────────────────────
*.log
/tmp/
corvin_operator/bridges/**/voice.log
# ULO runtime debug logs (CORVIN_ULO_DEBUG=1) — never committed, PII-free but large
.log/

# ── Generated content (output files Claude creates per session) ────────────
~/.cache/corvin-voice/

# Keep example/template files
!corvin_operator/bridges/discord/settings.json.example
!corvin_operator/bridges/telegram/settings.json.example
!corvin_operator/bridges/slack/settings.json.example
!corvin_operator/bridges/email/settings.json.example
!corvin_operator/bridges/whatsapp/settings.json.example

# ── Dynamic skill-forge slot mirror (engine-discoverable, never committed) ──
corvin_operator/skill-forge/skills/
corvin_operator/skill-forge/skills/dyn/

# Voice samples / generated artefacts
outputs/
output/

# Ad-hoc data exports / customer CSVs (PII — never commit)
*.csv

# ── Provider credentials / infrastructure secrets ──────────────────────────
.hetzner.env
*.secrets.env
*.credentials.env

# ── Local installation test (ops/docker-compose.local-test.yml) ─────────────
ops/local-test-data/
ops/.env.local-test

# Build artifacts (wheels/sdist) — never commit
dist/

# wrangler (Cloudflare Pages) local deploy cache
.wrangler/
playwright-results/

# local virtualenvs / test artifacts (never tracked)
venv*/
.venv*/
.test-env/
test-results/
playwright-report/
dist_release/

# Mid-turn heartbeat markers — legacy location inside the repo tree (F-B8, 2026-09-07):
# the adapter now writes them under <corvin_home>/bridges/mid_turn_heartbeats/.
corvin_operator/bridges/shared/mid_turn_heartbeats/
corvin_operator/bridges/shared/settings.json
