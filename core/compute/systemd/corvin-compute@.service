[Unit]
Description=Corvin Compute Worker (tenant %i)
Documentation=https://github.com/anthropics/corvinOS/blob/main/docs/decisions/0013-compute-worker-plugin.md
After=default.target

[Service]
Type=simple
# %h expands to the user's home directory; %i is the tenant id (template arg).
# WorkingDirectory + PYTHONPATH so the `corvin_compute` package is import-
# able without `pip install -e .` (the package ships as plain source).
WorkingDirectory=%h/projects/CorvinOS/core/compute
# PYTHONPATH includes the forge plugin so cli._build_runner_fn() can
# wire `forge.runner.run_tool()` as the real iteration backend (instead
# of falling back to the refuse-every-call stub).
Environment=PYTHONPATH=%h/projects/CorvinOS/core/compute:%h/projects/CorvinOS/corvin_operator/forge
# CORVIN_HOME pins forge.scope.corvin_home() to the same tree the
# worker's --corvin-home flag points at AND to the tree the console (corvin-webui.service) runs on:
# the console reads <home>/tenants/<tid>/compute/, so a worker on another home is invisible to it.
Environment=CORVIN_HOME=%h/projects/CorvinOS/.corvin
# Same interpreter as corvin-webui.service (the uv tool venv); core/compute has no venv of its own,
# so the previous core/compute/.venv path made the unit fail with status 203/EXEC.
ExecStart=%h/.local/share/uv/tools/corvinos/bin/python -m corvin_compute --corvin-home %h/projects/CorvinOS/.corvin serve --tenant %i
Restart=on-failure
RestartSec=5s
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
