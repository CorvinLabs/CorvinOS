{
  "skill_id": "os.workflow_optimizer",
  "version": "0.1.0",
  "name": "Workflow Optimizer",
  "description": "Learns execution chains and recommends workflow optimizations (latency, throughput, parallelization)",
  "layer": "L22",
  "capabilities": [
    "analyze_execution_chains",
    "detect_parallelizable_tasks",
    "estimate_speedup",
    "learn_from_feedback",
    "critical_path_analysis"
  ],
  "dependencies": [
    "os.context_adapter"
  ],
  "learning_enabled": true,
  "audit_enabled": true,
  "tenant_scoped": true,
  "tags": ["workflow", "optimization", "l22", "parallelization"],
  "lom_binding": {
    "file": "core/skills/os_skills/workflow_optimizer.py",
    "class": "WorkflowOptimizerSkill",
    "method": "execute",
    "line_start": 1
  },
  "schema": {
    "input": {
      "type": "object",
      "required": ["task_type", "execution_history", "current_shape"],
      "properties": {
        "task_type": {
          "type": "string",
          "description": "Type of workflow task (e.g., 'code_review', 'batch_processing')"
        },
        "execution_history": {
          "type": "array",
          "description": "List of past execution traces",
          "items": {
            "type": "object",
            "properties": {
              "task_id": { "type": "string" },
              "task_type": { "type": "string" },
              "subtasks": { "type": "array", "items": { "type": "string" } },
              "total_latency_ms": { "type": "number", "minimum": 0 },
              "per_task_latency_ms": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            },
            "required": ["task_id", "task_type", "subtasks", "total_latency_ms", "per_task_latency_ms"]
          }
        },
        "current_shape": {
          "type": "string",
          "enum": ["serial", "parallel_grouped"],
          "description": "Current workflow execution pattern"
        },
        "tenant_id": {
          "type": "string",
          "description": "Tenant ID (optional; defaults to '_default')"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "suggestion": { "type": "string", "enum": ["serial", "parallel_grouped", "insufficient_data"] },
        "estimated_speedup": { "type": "number", "minimum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reasoning": { "type": "string" },
        "learning_event_id": { "type": "string" },
        "parallelizable_groups": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "critical_path": { "type": "array", "items": { "type": "string" } },
        "current_shape": { "type": "string" }
      }
    }
  }
}
