# CorvinOS Console Monitoring Configuration
#
# Copy this file to .env in the project root and fill in your values
#
# Required for production deployments

# ────────────────────────────────────────────────────────────────────────
# SENTRY CONFIGURATION
# ────────────────────────────────────────────────────────────────────────
#
# Error tracking and performance monitoring
# Get DSN from https://sentry.io/organizations/<your-org>/projects/
# Format: https://<key>@<domain>.ingest.sentry.io/<project-id>
#
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=v5.1.1-hotfix
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ────────────────────────────────────────────────────────────────────────
# PROMETHEUS CONFIGURATION
# ────────────────────────────────────────────────────────────────────────
#
# Metrics collection and exposure
#
PROMETHEUS_SCRAPE_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# ────────────────────────────────────────────────────────────────────────
# PAGERDUTY ALERTING (for CRITICAL alerts)
# ────────────────────────────────────────────────────────────────────────
#
# PagerDuty integration for on-call escalation
# Get from PagerDuty: Services → Your Service → Integrations
#
PAGERDUTY_SERVICE_KEY=your-pagerduty-integration-key
PAGERDUTY_EVENT_ACTION=trigger  # trigger|acknowledge|resolve
PAGERDUTY_SEVERITY=critical

# ────────────────────────────────────────────────────────────────────────
# SLACK ALERTING (for WARNING/INFO alerts)
# ────────────────────────────────────────────────────────────────────────
#
# Slack webhooks for different alert categories
# Create webhooks: https://api.slack.com/messaging/webhooks
#

# Marketplace SLO alerts (latency, error rate, circuit breaker)
SLACK_WEBHOOK_URL_MARKETPLACE_SLO=https://hooks.slack.com/services/YOUR/MARKETPLACE/SLO/WEBHOOK

# Audit chain failures (GDPR compliance critical)
SLACK_WEBHOOK_URL_AUDIT_CHAIN=https://hooks.slack.com/services/YOUR/SECURITY/AUDIT/WEBHOOK

# Model API errors and fallback scenarios
SLACK_WEBHOOK_URL_MODEL_API=https://hooks.slack.com/services/YOUR/ML/MODEL/API/WEBHOOK

# Learning loop health and convergence
SLACK_WEBHOOK_URL_LEARNING=https://hooks.slack.com/services/YOUR/ML/LEARNING/WEBHOOK

# General ops alerts
SLACK_WEBHOOK_URL_OPS=https://hooks.slack.com/services/YOUR/OPS/GENERAL/WEBHOOK

# ────────────────────────────────────────────────────────────────────────
# ALERTMANAGER CONFIGURATION
# ────────────────────────────────────────────────────────────────────────
#
# Alerting backend (PagerDuty, Slack, Email, Opsgenie, etc.)
# This is the webhook URL for alertmanager to POST alerts to
#
ALERTMANAGER_WEBHOOK_URL=http://alertmanager:9093/api/v1/alerts

# ────────────────────────────────────────────────────────────────────────
# EMAIL ALERTING (for non-urgent alerts)
# ────────────────────────────────────────────────────────────────────────
#
# SMTP configuration for email alerts
# Recommended: use SendGrid, Mailgun, or your corporate mail server
#
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=alerts@example.com
ALERT_EMAIL_TO=ops-team@example.com

# ────────────────────────────────────────────────────────────────────────
# GRAFANA CONFIGURATION
# ────────────────────────────────────────────────────────────────────────
#
# Grafana dashboard settings
#
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your-grafana-api-key
GRAFANA_ORG_ID=1

# ────────────────────────────────────────────────────────────────────────
# MONITORING BEHAVIOR
# ────────────────────────────────────────────────────────────────────────
#

# Enable/disable components
MONITORING_SENTRY_ENABLED=true
MONITORING_METRICS_ENABLED=true
MONITORING_DASHBOARDS_ENABLED=true
MONITORING_ALERTS_ENABLED=true

# SLO thresholds (used by alert rules)
SLO_LATENCY_P99_MS=500
SLO_ERROR_RATE_PCT=0.1
SLO_DAILY_BUDGET_USD=50.0

# Circuit breaker recovery delay
CIRCUIT_BREAKER_RECOVERY_DELAY_SEC=60
CIRCUIT_BREAKER_OPEN_THRESHOLD=500  # milliseconds for latency

# Learning loop monitoring
LEARNING_CONVERGENCE_THRESHOLD=0.5
LEARNING_CONFIDENCE_MIN=0.7
LEARNING_FEEDBACK_WINDOW_DAYS=7

# ────────────────────────────────────────────────────────────────────────
# SENSITIVE CONFIGURATION (keep secret!)
# ────────────────────────────────────────────────────────────────────────
#
# Never commit these to version control!
# Use environment variables or secrets management (AWS Secrets Manager, etc.)
#

# Sentry auth token (for programmatic API access)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Grafana service account token (for dashboard API access)
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-grafana-service-account-token

# PagerDuty API token (for integration management)
PAGERDUTY_API_TOKEN=your-pagerduty-api-token

# ────────────────────────────────────────────────────────────────────────
# DEPLOYMENT ENVIRONMENT
# ────────────────────────────────────────────────────────────────────────
#
ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ────────────────────────────────────────────────────────────────────────
# NOTES FOR DEPLOYMENT
# ────────────────────────────────────────────────────────────────────────
#
# 1. Sentry integration:
#    - Create project in Sentry: https://sentry.io/signup/
#    - Copy DSN to SENTRY_DSN above
#    - Test with: curl -X POST ... (see README)
#
# 2. Prometheus + Grafana:
#    - Install: docker run -d --name prometheus prom/prometheus
#    - Add scrape config pointing to /metrics endpoint
#    - Install Grafana: docker run -d --name grafana grafana/grafana
#    - Import dashboards (see README)
#
# 3. Alerting:
#    - Choose backend: PagerDuty (production) or Slack (development)
#    - Create service + webhook
#    - Test alert firing
#
# 4. Daily setup checklist:
#    - [ ] Verify /metrics endpoint is healthy
#    - [ ] Check Prometheus scrape targets
#    - [ ] Confirm dashboards showing real data
#    - [ ] Test alert firing manually
#    - [ ] Verify on-call notification delivery
#
# For more details, see monitoring/README.md
