{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // Test files reference jest globals (describe/test/expect/jest), and no test
  // runner types are installed for this app. Type-checking them as part of the
  // APP build made `npm run build` — and therefore `uv build` — fail outright
  // (2026-07-22). They are excluded here rather than by adding @types/jest,
  // because nothing in this project actually runs them yet.
  // src/panels/skills_observability.tsx (e2c6d4a5c) imports three modules that
  // were never written (@/hooks/useAuth, @/hooks/useSkillsMetrics,
  // @/components/filters/TimeRangeSelector). Nothing imports the panel and its
  // backend router is mounted nowhere, so it is unreachable — but as part of
  // `include` it failed `tsc -b` and therefore every `npm run build` and
  // console deploy. Excluded until it is either wired for real or removed.
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/panels/skills_observability.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
