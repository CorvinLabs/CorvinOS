{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corvinOS.io/schemas/plugin-scaffold-v1.json",
  "title": "CorvinOS Plugin Scaffold Configuration",
  "description": "Schema for plugin.json configuration generated by Plugin-Builder v2 (ADR-0262)",
  "type": "object",
  "required": ["id", "name", "type", "version", "description"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique plugin identifier (e.g., 'org.plugin.name')",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$",
      "minLength": 3,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "description": "Human-readable plugin name",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g., '1.2.3' or '1.0.0-beta.1')",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9]+(\\.[a-z0-9]+)*)?$"
    },
    "type": {
      "type": "string",
      "description": "Plugin type classification",
      "enum": [
        "data_connector",
        "skill_plugin",
        "compute_engine",
        "bridge_channel",
        "worker_engine",
        "provider_plugin",
        "middleware",
        "integration"
      ]
    },
    "description": {
      "type": "string",
      "description": "Detailed plugin description",
      "minLength": 10,
      "maxLength": 5000
    },
    "author": {
      "type": "string",
      "description": "Plugin author name",
      "minLength": 1,
      "maxLength": 256
    },
    "requires_auth": {
      "type": "boolean",
      "description": "Whether plugin requires authentication (ADR-0247)",
      "default": false
    },
    "requires_network_egress": {
      "type": "boolean",
      "description": "Whether plugin requires network access (L35)",
      "default": false
    },
    "egress_hosts": {
      "type": "array",
      "description": "Allowed network egress hosts (L35 Network Egress Lockdown)",
      "items": {
        "type": "string",
        "format": "hostname"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "external_dependencies": {
      "type": "array",
      "description": "Required external Python packages (ADR-0247)",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+(>=?|<=?|==|!=|~=)?[0-9.]*$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "lifecycle_hooks": {
      "type": "array",
      "description": "Lifecycle hooks implemented by this plugin",
      "items": {
        "type": "string",
        "enum": ["on_load", "on_execute", "on_unload", "on_error"]
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "description": "Required plugin permissions (ADR-0233)",
      "items": {
        "type": "string",
        "enum": [
          "storage.read",
          "storage.write",
          "network.http",
          "network.https",
          "process.fork",
          "process.exec",
          "filesystem.read",
          "filesystem.write",
          "audit.read",
          "audit.write"
        ]
      },
      "uniqueItems": true
    },
    "boot_layer": {
      "type": "string",
      "description": "Boot layer (ADR-0243): bundled, installed, compliance, core",
      "enum": ["bundled", "installed", "compliance", "core"],
      "default": "installed"
    }
  },
  "additionalProperties": false
}
